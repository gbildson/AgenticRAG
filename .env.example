# Point these at a chat-completions endpoint with tool calling.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
CHAT_MODEL=replace-with-a-tool-capable-model

# Optional: enables cosine vector search alongside SQLite full-text search.
# EMBEDDING_MODEL=replace-with-an-embedding-model

# Optional data overrides. Set SQL_DATABASE_PATH=none for documents only.
# DOCUMENTS_DIR=/absolute/path/to/documents
# SQL_DATABASE_PATH=/absolute/path/to/database.sqlite
# SQL_ALLOWED_SCHEMA='{"tickets":["id","issue","status"]}'
# INDEX_DIR=/absolute/path/to/index
